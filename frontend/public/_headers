# 画面（Workers Static Assets）が返すヘッダー。kan/game のポータル（public/_headers）にそろえる。
# 書体は Google Fonts から読む（index.html）。Service Worker も書体を取りに行くので connect-src にも入れる。
# インラインの <script> と <style> は許さない（index.html の初めの色は src/boot.css）
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# 開発環境は検索エンジンに載せない（本番は載せる。TAKO-SEN・kan/game と同じ）
https://pujan-dev.kan-game.app/*
  X-Robots-Tag: noindex
